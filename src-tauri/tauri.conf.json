{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProcessHub",
  "version": "2.4.0",
  "identifier": "com.aakashhq.processhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProcessHub",
        "width": 800,
        "height": 550,
        "minWidth": 800,
        "minHeight": 550,
        "maxWidth": 800,
        "maxHeight": 550,
        "resizable": true,
        "visible": true,
        "theme": "Dark",
        "backgroundColor": "#17181a",
        "titleBarStyle": "Overlay",
        "trafficLightPosition": {
          "x": 20,
          "y": 21
        },
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'",
      "devCsp": "default-src 'self' http://localhost:1420; connect-src ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' http://localhost:1420; font-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' http://localhost:1420",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/icons/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/ProcessHub-HQ/processhub/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNERkQ0MjE5MTQ0Qzk4MEEKUldRS21Fd1VHVUw5UFNUY1BjVnNYZ0Q1QXVWYm45K1JDR2lhNlh0Z1lLQk9pTDFxSml5WFBacG0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
