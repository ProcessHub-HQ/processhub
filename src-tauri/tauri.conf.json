{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProcessHub",
  "version": "0.2.0",
  "identifier": "com.aakashhq.processhub",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ProcessHub",
        "width": 800,
        "height": 800,
        "minWidth": 800,
        "minHeight": 800,
        "maxWidth": 800,
        "maxHeight": 800,
        "resizable": false,
        "visible": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/icons/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
